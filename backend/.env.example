# Backend — copy to .env and set for production
# Secret for JWT — generate with: openssl rand -hex 32
SECRET_KEY=thyroid-lab-secret-change-in-prod-2024
# Comma-separated origins for CORS (add your Vercel/Firebase URLs after deploy)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.web.app,https://your-frontend.firebaseapp.com,http://localhost:3001
# Database — SQLite is ephemeral on Vercel/Firebase. For production, use Postgres:
# Example Neon / Supabase / Vercel Postgres:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./data/thyroid.db
# For Postgres, set DB file to use Postgres engine (app will auto-detect postgres://)
