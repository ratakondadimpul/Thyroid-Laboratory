# Frontend — set to your deployed backend URL
# For local dev: http://127.0.0.1:8000
# For Vercel + separate backend: https://your-backend.vercel.app  OR  https://your-backend.onrender.com  OR  https://your-cloud-run-url
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: used when building for Firebase Hosting static export
# FIREBASE_BUILD=true
